// LiquidGlass Compose prebuilts — 1.7.0 stable to match our compose-ui
// AOSP ships 1.7.0-alpha03 which is binary-incompatible with 1.7.0 stable

// ---- compose-runtime (stable 1.7.0) ----

android_library_import {
    name: "liquidglass-compose-runtime-nodeps",
    aars: ["runtime-android-1.7.0.aar"],
    sdk_version: "31",
    apex_available: ["//apex_available:platform"],
    min_sdk_version: "21",
    static_libs: [
        "androidx.annotation_annotation-experimental",
        "androidx.collection_collection",
        "kotlin-stdlib",
        "kotlinx_coroutines",
        "kotlinx_coroutines_android",
    ],
}

android_library {
    name: "liquidglass-compose-runtime",
    sdk_version: "31",
    apex_available: ["//apex_available:platform"],
    min_sdk_version: "21",
    manifest: "manifest/AndroidManifest.xml",
    static_libs: [
        "liquidglass-compose-runtime-nodeps",
        "androidx.annotation_annotation-experimental",
        "androidx.collection_collection",
        "kotlin-stdlib",
        "kotlinx_coroutines",
        "kotlinx_coroutines_android",
    ],
    java_version: "1.7",
}

