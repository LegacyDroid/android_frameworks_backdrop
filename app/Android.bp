android_library {
    name: "LiquidGlassCatalog",
    srcs: ["src/main/kotlin/**/*.kt"],
    platform_apis: true,
    manifest: "AndroidManifest.xml",
    resource_dirs: ["src/main/res"],

    static_libs: [
        "LiquidGlassBackdrop",
        "LiquidGlassShapes",
        "kotlinx-coroutines-android",
        "liquidglass-activity-compose",
        "liquidglass-compose-animation",
        "liquidglass-compose-animation-core",
        "liquidglass-compose-foundation",
        "liquidglass-material-ripple",
        "androidx.compose.runtime_runtime",
        "liquidglass-compose-ui",
        "liquidglass-compose-ui-graphics",
        "liquidglass-compose-ui-util",
    ],

    kotlincflags: [
        "-opt-in=androidx.compose.foundation.ExperimentalFoundationApi",
        "-opt-in=androidx.compose.runtime.ExperimentalComposeApi",
    ],
}
